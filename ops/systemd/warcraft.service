[Unit]
Description=Warcraft realm (AzerothCore + Playerbots)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/warcraft/azerothcore
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
# Loading maps and spawning the bot population is slow on a cold start.
TimeoutStartSec=1800
User=nlucansk

[Install]
WantedBy=multi-user.target
