# Pinned revisions - see MANIFEST.md. Never track a moving branch in production.
AC_REPO=https://github.com/mod-playerbots/azerothcore-wotlk.git
AC_BRANCH=Playerbot
AC_COMMIT=efe123fab543c5faf3c477674ec17a18fd59f09f

PLAYERBOTS_REPO=https://github.com/mod-playerbots/mod-playerbots.git
PLAYERBOTS_COMMIT=8d9f6aa6bc6d45f9ae0ee0675b9b1f8aa6937312

AHBOT_REPO=https://github.com/azerothcore/mod-ah-bot.git
AHBOT_COMMIT=a680cc1c98290713e9b3d3289544af78e5186dc1

# Generated by bootstrap.sh on first run
DOCKER_DB_ROOT_PASSWORD=changeme

DOCKER_IMAGE_TAG=playerbot
DOCKER_USER=acore
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

# Host paths. Absolute so compose resolves them the same from any cwd.
DOCKER_VOL_ETC=/opt/warcraft/config
DOCKER_VOL_LOGS=/opt/warcraft/logs

# Published ports. DB and SOAP stay loopback-only (BRD s7: local-only DB exposure).
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878
DOCKER_DB_EXTERNAL_PORT=3306
DOCKER_RA_EXTERNAL_PORT=3443

# Compile parallelism. Each clang job peaks near 1.5 GB; keep jobs*1.5G under host RAM
# or the build gets OOM-killed halfway through and leaves a poisoned ccache.
BUILD_JOBS=3

MYSQL_BUFFER_POOL=1G
MYSQL_MAX_CONNECTIONS=300

# Realm address handed to clients after auth. Must be reachable from the LAN.
REALM_ADDRESS=10.10.25.193
REALM_NAME=Aetherion
